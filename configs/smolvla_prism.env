# New PRISM training: learned per-feature alpha initialized to 0.01.
# Keep these explicit overrides; serialized config defaults preserve legacy checkpoints.
SEED=1000
STEPS=100000
BATCH_SIZE=64
NUM_WORKERS=8
PREFETCH_FACTOR=4
PERSISTENT_WORKERS=true
STATE_CONDITIONER_TYPE=prism
STATE_CONDITIONER_NUM_LAYERS=2
STATE_CONDITIONER_PRODUCT_MODE=gated_quadratic
STATE_CONDITIONER_GATE_SCALE_INIT=1e-2
STATE_CONDITIONER_USE_RMSNORM=true
SCHEDULER_WARMUP_STEPS=100
SCHEDULER_DECAY_STEPS=100000
POLICY_LOAD_VLM_WEIGHTS=true
FREEZE_VISION_ENCODER=true
TRAIN_EXPERT_ONLY=true
