# New PRISM training: learned per-feature alpha initialized to 0.01.
# Keep these explicit overrides; serialized config defaults preserve legacy checkpoints.
BFM_SEED=1000
BFM_DEVICE=cuda:0
BFM_ONLINE_PARALLEL_ENVS=512
BFM_UPDATE_AGENT_EVERY=512
BFM_NUM_SEED_STEPS=5120
BFM_NUM_AGENT_UPDATES=16
BFM_NUM_ENV_STEPS=9600000
BFM_BUFFER_SIZE=2560000
BFM_BUFFER_DEVICE=cuda
BFM_EVAL_NUM_ENVS=128
BFM_LOG_EVERY_UPDATES=192000
BFM_EVAL_EVERY_STEPS=4800000
BFM_CHECKPOINT_EVERY_STEPS=4800000
BFM_HISTORY_CONDITIONER_TYPE=prism
BFM_HISTORY_CONDITIONER_NUM_LAYERS=2
BFM_HISTORY_CONDITIONER_USE_RMSNORM=true
BFM_HISTORY_CONDITIONER_PRODUCT_MODE=gated_quadratic
BFM_HISTORY_CONDITIONER_GATE_SCALE_INIT=1e-2
