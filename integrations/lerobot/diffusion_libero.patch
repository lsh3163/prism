+def _nanmean(values: list[float]) -> float:
+    if not values:
+        return float("nan")
+    return float(np.nanmean(values))
+
+
+def _compute_compliance_episode_metrics(
+    actions: Tensor,
+    successes: Tensor,
+    mask: Tensor,
+    final_window_fraction: float = 0.2,
+) -> dict[str, float]:
+    """Compute rollout diagnostics that expose compliance-like behavior.
+
+    These are intentionally post-hoc metrics: they use the original task success
+    signal and applied actions, not an explicit compliance reward.
+    """
+    valid = mask.to(dtype=torch.bool)
+    valid_actions = actions[valid]
+    valid_successes = successes[valid].to(dtype=torch.bool)
+    if valid_actions.numel() == 0:
+        return {
+            "action_smoothness": float("nan"),
+            "contact_loss_rate": float("nan"),
+            "final_stability": float("nan"),
+        }
+
+    if valid_actions.shape[0] > 1:
+        action_delta = valid_actions[1:] - valid_actions[:-1]
+        action_smoothness = float(torch.mean(action_delta.square()).item())
+    else:
+        action_smoothness = 0.0
+
+    success_indices = torch.nonzero(valid_successes, as_tuple=False).flatten()
+    if success_indices.numel() == 0:
+        contact_loss_rate = float("nan")
+    else:
+        after_first_success = valid_successes[success_indices[0] :]
+        contact_loss_rate = float((~after_first_success).float().mean().item() * 100.0)
+
+    final_window = max(1, int(np.ceil(valid_successes.numel() * final_window_fraction)))
+    final_stability = float(valid_successes[-final_window:].float().mean().item() * 100.0)
+
+    return {
+        "action_smoothness": action_smoothness,
+        "contact_loss_rate": contact_loss_rate,
+        "final_stability": final_stability,
+    }
+
+
+def _compute_mcc_episode_metrics(
+    eef_pos_errors: Tensor,
+    eef_ori_errors: Tensor,
+    contact_force_proxies: Tensor,
+    excess_contacts: Tensor,
+    mask: Tensor,
+) -> dict[str, float]:
+    valid = mask.to(dtype=torch.bool)
+    if not torch.any(valid):
+        return {
+            "eef_pos_error": float("nan"),
+            "eef_ori_error": float("nan"),
+            "peak_contact_force_proxy": float("nan"),
+            "excess_contact_rate": float("nan"),
+        }
+
+    valid_pos = eef_pos_errors[valid].float()
+    valid_ori = eef_ori_errors[valid].float()
+    valid_force = contact_force_proxies[valid].float()
+    valid_excess = excess_contacts[valid].to(dtype=torch.float32)
+    finite_force = valid_force[~torch.isnan(valid_force)]
+    return {
+        "eef_pos_error": float(torch.nanmean(valid_pos).item()),
+        "eef_ori_error": float(torch.nanmean(valid_ori).item()),
+        "peak_contact_force_proxy": float(finite_force.max().item()) if finite_force.numel() else float("nan"),
+        "excess_contact_rate": float(torch.nanmean(valid_excess).item() * 100.0),
+    }
 
 
