+def _episode_frame_ranges_for_sampler(dataset) -> tuple[list[int], list[int], list[int] | None]:
+    """Return episode frame ranges in the same index space as ``dataset.__getitem__``."""
+    episode_from_indices = dataset.meta.episodes["dataset_from_index"]
+    episode_to_indices = dataset.meta.episodes["dataset_to_index"]
+
+    if dataset.episodes is None:
+        return episode_from_indices, episode_to_indices, None
+
+    # ``LeRobotDataset(episodes=...)`` filters the underlying HF dataset, so
+    # ``__getitem__`` expects local row indices. Metadata ranges remain global
+    # frame indices, so remap each selected episode before constructing the
+    # episode-aware sampler.
+    _ = dataset.hf_dataset
+    absolute_to_relative_idx = getattr(dataset.reader, "_absolute_to_relative_idx", None)
+    if absolute_to_relative_idx is None:
+        raise RuntimeError("Episode-filtered dataset did not build an absolute-to-relative index map.")
+
+    local_from_indices = []
+    local_to_indices = []
+    for episode_idx in dataset.episodes:
+        start_idx = int(episode_from_indices[episode_idx])
+        end_idx = int(episode_to_indices[episode_idx])
+        try:
+            local_from_indices.append(absolute_to_relative_idx[start_idx])
+            local_to_indices.append(absolute_to_relative_idx[end_idx - 1] + 1)
+        except KeyError as exc:
+            raise RuntimeError(
+                f"Could not remap episode {episode_idx} into the filtered dataset index space."
+            ) from exc
+
+    return local_from_indices, local_to_indices, None
+
