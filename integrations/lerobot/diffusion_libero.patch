+def _vector_info_values(info: dict[str, Any], key: str, n_envs: int, default: Any) -> list[Any]:
+    if key in info:
+        value = info[key]
+        if hasattr(value, "tolist"):
+            value = value.tolist()
+        if isinstance(value, list):
+            return value
+        return [value] * n_envs
+    return [default] * n_envs
+
+
+def _apply_eval_observation_perturbations(observation: dict[str, Any]) -> dict[str, Any]:
+    """Apply optional evaluation-only perturbations for robustness sweeps.
+
+    Controlled through environment variables so normal evaluation is unchanged.
+    """
+    proprio_noise = float(os.environ.get("LEROBOT_EVAL_PROPRIO_NOISE_STD", "0") or 0)
+    image_noise = float(os.environ.get("LEROBOT_EVAL_IMAGE_NOISE_STD", "0") or 0)
+    if proprio_noise <= 0 and image_noise <= 0:
+        return observation
+
+    observation = dict(observation)
+    if proprio_noise > 0 and OBS_STATE in observation and torch.is_tensor(observation[OBS_STATE]):
+        observation[OBS_STATE] = observation[OBS_STATE] + proprio_noise * torch.randn_like(
+            observation[OBS_STATE]
+        )
+
+    if image_noise > 0:
+        for key, value in list(observation.items()):
+            if not (isinstance(key, str) and key.startswith("observation.images.") and torch.is_tensor(value)):
+                continue
+            scale = 255.0 if float(value.detach().max().item()) > 2.0 else 1.0
+            noisy = value + (image_noise * scale) * torch.randn_like(value)
+            observation[key] = noisy.clamp(0.0, scale)
+    return observation
 
 
