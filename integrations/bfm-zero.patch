+def _read_env_int(name: str, current: int) -> int:
+    value = os.getenv(name)
+    if value is None:
+        return current
+    return int(value)
+
+
+def _read_env_str(name: str, current: str) -> str:
+    value = os.getenv(name)
+    if value is None:
+        return current
+    return value
+
+
+def _read_env_bool(name: str, current: bool) -> bool:
+    value = os.getenv(name)
+    if value is None:
+        return current
+    value = value.strip().lower()
+    if value in {"1", "true", "yes", "on"}:
+        return True
+    if value in {"0", "false", "no", "off"}:
+        return False
+    raise ValueError(f"Unsupported boolean env override {name}={value!r}")
+
+
+def _read_env_optional_int(name: str) -> int | None:
+    value = os.getenv(name)
+    if value is None or value == "":
