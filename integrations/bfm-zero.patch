 class DictInputFilter(nn.Module):
     """
     Simple input filter that extracts a specific key from a dictionary input space.
@@ -108,10 +128,121 @@ class DictInputConcatFilter(nn.Module):
         return _input
 
 
+class _HistoryActorPostMLP(nn.Module):
+    def __init__(self, input_dim: int, output_dim: int, hidden_dim: int, num_layers: int) -> None:
+        super().__init__()
+        if num_layers < 1:
+            raise ValueError("num_layers must be >= 1")
+        if num_layers == 1:
+            self.net = nn.Linear(input_dim, output_dim)
+            return
+
+        layers: list[nn.Module] = [nn.Linear(input_dim, hidden_dim), nn.Mish()]
+        for _ in range(num_layers - 2):
+            layers.extend([nn.Linear(hidden_dim, hidden_dim), nn.Mish()])
+        layers.append(nn.Linear(hidden_dim, output_dim))
+        self.net = nn.Sequential(*layers)
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        return self.net(x)
+
+
+class RMSNorm(nn.Module):
+    def __init__(self, hidden_size: int, eps: float = 1e-6) -> None:
+        super().__init__()
+        self.eps = eps
+        self.weight = nn.Parameter(torch.ones(hidden_size))
+
+    def forward(self, x: torch.Tensor) -> torch.Tensor:
+        x_fp32 = x.float()
+        rms = x_fp32.pow(2).mean(dim=-1, keepdim=True).add(self.eps).rsqrt()
+        return (x_fp32 * rms).to(dtype=x.dtype) * self.weight
+
+
+class HistoryActorPRISMConcatFilter(nn.Module):
+    """
+    Input filter that applies a learned polynomial feature transform to the
+    history branch only, then concatenates the full observation tuple.
+    """
+
+    def __init__(self, input_space, cfg: HistoryActorPRISMFilterConfig) -> None:
+        super().__init__()
+        self.cfg = cfg
+        self.output_space = self.get_output_space(input_space, cfg)
+
+        history_space = input_space.spaces[cfg.history_key]
+        history_dim = history_space.shape[0]
+        output_dim = cfg.output_dim or history_dim
+        hidden_dim = cfg.hidden_dim or output_dim
+
+        if cfg.product_mode not in {"vanilla", "gated_quadratic"}:
+            raise ValueError(f"Unsupported PRISM product_mode={cfg.product_mode!r}")
+        self.product_mode = cfg.product_mode
+        self.left_proj = nn.Linear(history_dim, hidden_dim)
+        self.right_proj = nn.Linear(history_dim, hidden_dim)
+        if cfg.product_mode == "gated_quadratic":
+            self.quadratic_scale = nn.Parameter(torch.full((hidden_dim,), float(cfg.gate_scale_init)))
+            nn.init.zeros_(self.right_proj.bias)
+        else:
+            self.register_parameter("quadratic_scale", None)
+        self.post_mlp = _HistoryActorPostMLP(hidden_dim, output_dim, hidden_dim, cfg.num_layers)
+        self.output_norm = RMSNorm(output_dim, eps=cfg.rmsnorm_eps) if cfg.use_rmsnorm else nn.Identity()
+
+    @classmethod
+    def get_output_space(cls, input_space, cfg: HistoryActorPRISMFilterConfig):
+        assert isinstance(input_space, gymnasium.spaces.Dict), "input_space must be a Dict space"
+        assert all(key in input_space.spaces for key in cfg.key), f"keys {cfg.key} not found in obs_space {input_space.spaces.keys()}"
+        assert cfg.history_key in cfg.key, f"history_key {cfg.history_key} must be included in key sequence {cfg.key}"
+        assert all(isinstance(input_space[key], gymnasium.spaces.Box) for key in cfg.key), "All keys must be Box spaces"
+        assert all(len(input_space[key].shape) == 1 for key in cfg.key), (
+            f"All key spaces must have 1D shape, got {[input_space[key].shape for key in cfg.key]}"
+        )
+
+        history_space = input_space.spaces[cfg.history_key]
+        history_dim = history_space.shape[0]
+        output_dim = cfg.output_dim or history_dim
+        first_dtype = input_space.spaces[cfg.key[0]].dtype
+        assert all(input_space.spaces[key].dtype == first_dtype for key in cfg.key), (
+            f"All keys must have the same dtype {input_space.spaces[cfg.key[0]].dtype}"
+        )
+
+        lows = []
+        highs = []
+        for key in cfg.key:
+            space = input_space.spaces[key]
+            if key == cfg.history_key:
+                lows.append(np.full((output_dim,), -np.inf, dtype=first_dtype))
+                highs.append(np.full((output_dim,), np.inf, dtype=first_dtype))
+            else:
+                lows.append(space.low)
+                highs.append(space.high)
+        return gymnasium.spaces.Box(low=np.concatenate(lows), high=np.concatenate(highs), dtype=first_dtype)
+
+    def forward(self, _input: torch.Tensor | dict[str, torch.Tensor]):
+        if not isinstance(_input, dict):
+            return _input
+
+        parts = []
+        for key in self.cfg.key:
+            value = _input[key]
+            if key == self.cfg.history_key:
+                left = self.left_proj(value)
+                right = self.right_proj(value)
+                if self.product_mode == "gated_quadratic":
+                    value = left * (1.0 + self.quadratic_scale * right)
+                else:
+                    value = left * right
+                value = self.post_mlp(value)
+                value = self.output_norm(value)
+            parts.append(value)
+        return torch.cat(parts, dim=-1)
+
+
 NNFilter = tp.Annotated[
