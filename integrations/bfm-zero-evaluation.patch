+def _parse_hydra_overrides(hydra_overrides_json: str | None) -> list[str]:
+    if not hydra_overrides_json:
+        return []
+    parsed = json.loads(hydra_overrides_json)
+    if not isinstance(parsed, list) or not all(isinstance(item, str) for item in parsed):
+        raise ValueError("hydra_overrides_json must decode to a JSON list of strings.")
+    return parsed
+
+
+def _build_expert_qpos(obs_dict) -> np.ndarray:
+    return np.concatenate(
+        [
+            obs_dict["ref_body_pos"][:, 0].cpu().numpy(),
+            np.roll(obs_dict["ref_body_rots"][:, 0].cpu().numpy(), 1, axis=-1),
+            obs_dict["dof_pos"].cpu().numpy(),
+        ],
+        axis=-1,
+    )
+
+
+def _actor_representation(model, observation):
+    """Return the normalized actor input after the model's configured input filter."""
+    with torch.no_grad():
+        normalized = model._normalize(observation)
+        actor_filter = model._actor.input_filter
+        actor_filtered = actor_filter(normalized)
+
+        raw_history = None
+        conditioned_history = None
+        if isinstance(normalized, dict) and "history_actor" in normalized:
+            raw_history = normalized["history_actor"]
+            conditioned_history = raw_history
+
+            cfg = getattr(actor_filter, "cfg", None)
+            history_key = getattr(cfg, "history_key", None)
+            if (
+                history_key is not None
+                and history_key in normalized
+                and hasattr(actor_filter, "left_proj")
+                and hasattr(actor_filter, "right_proj")
+            ):
+                history = normalized[history_key]
+                left = actor_filter.left_proj(history)
+                right = actor_filter.right_proj(history)
+                if getattr(actor_filter, "product_mode", "vanilla") == "gated_quadratic":
+                    conditioned_history = left * (1.0 + actor_filter.quadratic_scale * right)
+                else:
+                    conditioned_history = left * right
+                conditioned_history = actor_filter.post_mlp(conditioned_history)
+                conditioned_history = actor_filter.output_norm(conditioned_history)
+
+    def to_numpy(value):
+        if value is None:
+            return None
+        return value.detach().float().cpu().numpy()
+
+    return {
+        "actor_filtered": to_numpy(actor_filtered),
+        "history_raw": to_numpy(raw_history),
+        "history_conditioned": to_numpy(conditioned_history),
+    }
+
+
+def _reset_env_to_motion_target(wrapped_env, obs_dict, simulator: str, num_envs: int):
+    wrapped_env.reset(to_numpy=False)
+
+    ref_body_rots = obs_dict["ref_body_rots"][0, 0].clone()
+    if simulator == "isaacsim":
+        ref_body_rots = ref_body_rots[[3, 0, 1, 2]]  # xyzw -> wxyz for correct humanoid facing in Isaac
+
+    ref_root_init_state = torch.cat(
+        [
+            obs_dict["ref_body_pos"][0, 0],
+            ref_body_rots,
+            obs_dict["ref_body_vels"][0, 0],
+            obs_dict["ref_body_angular_vels"][0, 0],
+        ]
+    )
+    dof_init_state = torch.zeros_like(wrapped_env._env.simulator.dof_state.view(num_envs, -1, 2)[0])
+    dof_init_state[..., 0] = obs_dict["dof_pos"][0]
+    dof_init_state[..., 1] = obs_dict["ref_dof_vel"][0]
+    target_states = {
+        "dof_states": dof_init_state,
+        "root_states": torch.stack([ref_root_init_state.clone() for _ in range(num_envs)]),
+    }
+    env_ids = torch.arange(num_envs, dtype=torch.long)
+    wrapped_env._env.reset_envs_idx(env_ids, target_states=target_states)
+    wrapped_env.step(
+        torch.zeros((num_envs, wrapped_env.action_space.shape[-1]), dtype=torch.float32),
+        to_numpy=False,
+    )
+    observation = wrapped_env._get_g1env_observation(to_numpy=False)
+    return observation
+
