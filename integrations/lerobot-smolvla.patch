+class RMSNorm(nn.Module):
+    """Minimal RMSNorm operating on the last dimension."""
+
+    def __init__(self, dim: int, eps: float = 1e-6):
+        super().__init__()
+        self.weight = nn.Parameter(torch.ones(dim))
+        self.eps = eps
+
+    def forward(self, x: Tensor) -> Tensor:
+        rms = x.pow(2).mean(dim=-1, keepdim=True)
+        x = x * torch.rsqrt(rms + self.eps)
+        return x * self.weight
+
+
+class MLPStateConditioner(nn.Module):
+    """State-only conditioner used for proprioception baselines."""
+
+    def __init__(self, input_dim: int, output_dim: int, hidden_dim: int, num_layers: int):
+        super().__init__()
+        if num_layers < 1:
+            raise ValueError(f"num_layers must be >= 1, got {num_layers}")
+
+        dims = [input_dim]
+        if num_layers == 1:
+            dims.append(output_dim)
+        else:
+            dims.extend([hidden_dim] * (num_layers - 1))
+            dims.append(output_dim)
+
+        layers: list[nn.Module] = []
+        for idx in range(len(dims) - 1):
+            layers.append(nn.Linear(dims[idx], dims[idx + 1]))
+            if idx < len(dims) - 2:
+                layers.append(nn.SiLU())
+        self.net = nn.Sequential(*layers)
+
+    def forward(self, state: Tensor) -> Tensor:
+        return self.net(state)
+
+
+class PRISMStateConditioner(nn.Module):
+    """Apply the PRISM/poly-kernel transform on proprioception only."""
+
+    def __init__(
+        self,
+        input_dim: int,
+        output_dim: int,
+        hidden_dim: int,
+        num_layers: int,
+        product_mode: str = "vanilla",
+        gate_scale_init: float = 1e-2,
+    ):
+        super().__init__()
+        if product_mode not in {"vanilla", "gated_quadratic"}:
+            raise ValueError(f"Unsupported product_mode={product_mode!r}")
+        self.product_mode = product_mode
+        self.left_proj = nn.Linear(input_dim, hidden_dim)
+        self.right_proj = nn.Linear(input_dim, hidden_dim)
+        if product_mode == "gated_quadratic":
+            self.quadratic_scale = nn.Parameter(torch.full((hidden_dim,), float(gate_scale_init)))
+            nn.init.zeros_(self.right_proj.bias)
+        else:
+            self.register_parameter("quadratic_scale", None)
+        self.post_mlp = MLPStateConditioner(hidden_dim, output_dim, hidden_dim, num_layers)
+
+    def forward(self, state: Tensor) -> Tensor:
+        left = self.left_proj(state)
+        right = self.right_proj(state)
+        if self.product_mode == "gated_quadratic":
+            poly_features = left * (1.0 + self.quadratic_scale * right)
+        else:
+            poly_features = left * right
+        return self.post_mlp(poly_features)
+
